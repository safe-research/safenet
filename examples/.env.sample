# ============================================================
# Safenet Examples — Environment Configuration
# ============================================================
# Copy this file to examples/.env and fill in the values.

# RPC endpoints
RPC_URL=https://rpc.gnosischain.com

# Safenet Consensus contract on Gnosis Chain (chain ID 100)
CONSENSUS_ADDRESS=0x223624cBF099e5a8f8cD5aF22aFa424a1d1acEE9

# Address of the oracle contract the transaction was proposed against
ORACLE_ADDRESS=

# Safe Transaction Service (Sepolia)
SAFE_TX_SERVICE_URL=https://api.safe.global/tx-service/sep
SAFE_TX_SERVICE_API_KEY=

# Optional: first block to scan for the guard's epoch events (defaults to 0 — set to the
# guard's deployment block to avoid scanning the whole chain).
# GUARD_FROM_BLOCK=0

# Optional: attestation poll timeout in seconds (default: 120)
# ATTESTATION_TIMEOUT_SECONDS=120
