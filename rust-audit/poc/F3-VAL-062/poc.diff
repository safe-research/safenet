diff --git a/crates/validator/src/state/keygen.rs b/crates/validator/src/state/keygen.rs
index a59ee7b..ea60f38 100644
--- a/crates/validator/src/state/keygen.rs
+++ b/crates/validator/src/state/keygen.rs
@@ -1445,3 +1445,187 @@ macro_rules! fail_rollover {
     }};
 }
 use fail_rollover;
+
+// F3-VAL-062 PoC (temporary): a warp page applies all of a key generation's
+// commitments AND the peers' secret shares before the validator's own
+// `Resume::Setup` lands, because effects only run after the whole page. The
+// share events, handled only in `CollectingShares`, are dropped while the state
+// is still `CollectingCommitments` "waiting for setup"; the late setup then
+// enters `CollectingShares` with an empty `shared` set, and derives the share
+// deadline from the commitment deadline (+key_gen_timeout) rather than the last
+// commitment block, so it also runs ~key_gen_timeout blocks behind its peers.
+#[cfg(test)]
+mod poc_f3_val_062 {
+    use super::*;
+    use crate::{
+        bindings::Coordinator,
+        config::{Participant, ValidatorConfig},
+        consensus::hashing::ConsensusDomain,
+        frost::identity_attack,
+        service::{Event, Resume},
+    };
+    use alloy::primitives::{Address, address};
+    use safenet_core::{
+        index::{EventBlock, EventLog},
+        state::{Message, StateTransition},
+    };
+
+    fn coord_log(block: u64, index: u64, event: Coordinator::CoordinatorEvents) -> EventLog<Event> {
+        EventLog {
+            block: EventBlock {
+                number: block,
+                timestamp: block,
+            },
+            index,
+            address: Address::ZERO,
+            data: Event::Coordinator(event),
+        }
+    }
+
+    const ADDRS: [Address; 5] = [
+        address!("0x1000000000000000000000000000000000000001"),
+        address!("0x2000000000000000000000000000000000000002"),
+        address!("0x3000000000000000000000000000000000000003"),
+        address!("0x4000000000000000000000000000000000000004"),
+        address!("0x5000000000000000000000000000000000000005"),
+    ];
+    const CONSENSUS: Address = address!("0x00000000000000000000000000000000000000c0");
+
+    fn transition() -> Transition {
+        let participants = ADDRS
+            .iter()
+            .map(|&address| Participant {
+                address,
+                active_from: 0,
+                active_before: None,
+            })
+            .collect::<Vec<_>>();
+        let config = ValidatorConfig {
+            consensus: CONSENSUS,
+            staker: None,
+            participants,
+            oracles: BTreeSet::new(),
+            genesis_salt: B256::ZERO,
+            blocks_per_epoch: NonZeroU64::new(1440).unwrap(),
+            key_gen_timeout: NonZeroU64::new(120).unwrap(),
+            signing_timeout: NonZeroU64::new(6).unwrap(),
+            oracle_timeout: NonZeroU64::new(24).unwrap(),
+        };
+        let genesis =
+            group::participants_set(&config.participants, group::Epoch::Genesis { salt: B256::ZERO })
+                .unwrap();
+        Transition {
+            account: ADDRS[0],
+            genesis,
+            consensus: ConsensusDomain::new(100, CONSENSUS),
+            config,
+        }
+    }
+
+    fn pset(t: &Transition, number: NonZeroU64) -> group::ParticipantSet {
+        group::participants_set(
+            &t.config.participants,
+            group::Epoch::Number {
+                consensus: CONSENSUS,
+                number,
+                excluded: BTreeSet::new(),
+            },
+        )
+        .unwrap()
+    }
+
+    fn collecting_shares(state: &State) -> (usize, Option<u64>) {
+        match &state.rollover {
+            RolloverState::CollectingShares {
+                shared, deadline, ..
+            } => (shared.len(), *deadline),
+            other => panic!("expected CollectingShares, got {other:?}"),
+        }
+    }
+
+    #[test]
+    fn warp_order_drops_peer_share_and_delays_deadline() {
+        let number = NonZeroU64::new(2).unwrap();
+
+        // Live order (control): the validator's own setup resumes BEFORE the
+        // peer's share event, so the share is counted.
+        let t = transition();
+        let participant_set = pset(&t, number);
+        let gid = participant_set.group().id();
+        let (me_secrets, commitments, peer_shares) =
+            identity_attack::honest_vectors(&ADDRS, 3, ADDRS[0]);
+        let (state, _) = t.start_key_gen(State::default(), EpochId::Number { number }, &participant_set, Some(120));
+        let (mut state, _) = t.apply_transition(
+            state,
+            Message::Resume(Resume::Setup {
+                group_id: gid,
+                secrets: Box::new(me_secrets),
+            }),
+        );
+        for (i, (addr, commitment)) in commitments.into_iter().enumerate() {
+            let event = Coordinator::CoordinatorEvents::KeyGenCommitted(Coordinator::KeyGenCommitted {
+                gid,
+                participant: addr,
+                commitment,
+                committed: true,
+            });
+            (state, _) = t.apply_transition(state, Message::Event(coord_log(1, i as u64, event)));
+        }
+        let (peer, share) = peer_shares.into_iter().next().unwrap();
+        let event = Coordinator::CoordinatorEvents::KeyGenSecretShared(Coordinator::KeyGenSecretShared {
+            gid,
+            participant: peer,
+            share,
+            shared: true,
+        });
+        (state, _) = t.apply_transition(state, Message::Event(coord_log(2, 0, event)));
+        let (live_shared, live_deadline) = collecting_shares(&state);
+        assert_eq!(live_shared, 1, "live order counts the peer's share");
+        assert_eq!(live_deadline, Some(121), "live deadline = last commitment block + key_gen_timeout");
+
+        // Warp order: all commitments AND the peer's share arrive (in one page)
+        // before the validator's own setup resumes. The share is dropped.
+        let t = transition();
+        let participant_set = pset(&t, number);
+        let gid = participant_set.group().id();
+        let (me_secrets, commitments, peer_shares) =
+            identity_attack::honest_vectors(&ADDRS, 3, ADDRS[0]);
+        let (mut state, _) = t.start_key_gen(State::default(), EpochId::Number { number }, &participant_set, Some(120));
+        for (i, (addr, commitment)) in commitments.into_iter().enumerate() {
+            let event = Coordinator::CoordinatorEvents::KeyGenCommitted(Coordinator::KeyGenCommitted {
+                gid,
+                participant: addr,
+                commitment,
+                committed: true,
+            });
+            (state, _) = t.apply_transition(state, Message::Event(coord_log(1, i as u64, event)));
+        }
+        // All committed but the setup has not resumed: the state is still
+        // CollectingCommitments "waiting for setup".
+        assert!(matches!(state.rollover, RolloverState::CollectingCommitments { .. }));
+        let (peer, share) = peer_shares.into_iter().next().unwrap();
+        let event = Coordinator::CoordinatorEvents::KeyGenSecretShared(Coordinator::KeyGenSecretShared {
+            gid,
+            participant: peer,
+            share,
+            shared: true,
+        });
+        (state, _) = t.apply_transition(state, Message::Event(coord_log(1, 5, event)));
+        // Now the setup finally resumes and closes the commitment round.
+        let (state, _) = t.apply_transition(
+            state,
+            Message::Resume(Resume::Setup {
+                group_id: gid,
+                secrets: Box::new(me_secrets),
+            }),
+        );
+        let (warp_shared, warp_deadline) = collecting_shares(&state);
+        assert_eq!(warp_shared, 0, "warp order drops the peer share seen before setup");
+        assert_eq!(
+            warp_deadline,
+            Some(240),
+            "late-setup deadline = commitment deadline + key_gen_timeout, not last commitment block"
+        );
+        assert!(warp_deadline > live_deadline, "warp share round runs behind the live one");
+    }
+}
