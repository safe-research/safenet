+    /// QA3 F3-CORE-032: drives the real core `StateMachine` (snapshots and
+    /// rollback) with the real `SentinelTransition`. The proposal and its
+    /// `NewRequest` land in block S; the engine verdict resumes after S's
+    /// snapshot, as `Driver::update` spawns effects only after
+    /// `handle_update`; our own commit lands in S + 2. With `rollback`, a
+    /// one-block uncle (or a restart whose restore point is S) restores S and
+    /// the chain is replayed. Returns every command produced after the verdict
+    /// and the request's state in the newest snapshot.
+    async fn qa3_run(rollback: bool) -> (Vec<Command<SentinelAction, effect::Effect>>, Option<RequestState>) {
+        use safenet_core::{
+            index::{BlockUpdate, EventUpdate, Update},
+            state::StateMachine,
+            utils,
+        };
+        use sqlx::sqlite::SqliteConnectOptions;
+        use std::str::FromStr;
+
+        const S: u64 = 100;
+        let safe_tx_hash = B256::repeat_byte(0x01);
+        let id = request_id(safe_tx_hash, 7, ORACLE);
+        let bond = U96::from(800_000_000u64);
+        let pool = utils::connect_sqlite(SqliteConnectOptions::from_str("sqlite::memory:").unwrap())
+            .await
+            .unwrap();
+        let mut machine = StateMachine::<State, SentinelTransition>::new(transition(), pool.clone())
+            .await
+            .unwrap();
+        let logs_for = |n: u64| -> Vec<EventLog<SentinelEvents>> {
+            let events = match n {
+                S => vec![
+                    proposed_event(ORACLE, safe_tx_hash, TO),
+                    new_request_event(
+                        id,
+                        U256::from(400_000u64),
+                        U256::from(bond),
+                        U256::from(400_000u64),
+                        S + 6,
+                        S + 12,
+                    ),
+                ],
+                n if n == S + 2 => vec![committed_event(id, self_address(), 800_000_000u64)],
+                _ => vec![],
+            };
+            events
+                .into_iter()
+                .enumerate()
+                .map(|(index, data)| EventLog {
+                    index: index as u64,
+                    ..log(n, data)
+                })
+                .collect()
+        };
+        let apply = async |machine: &mut StateMachine<State, SentinelTransition>, n: u64| {
+            let mut commands = machine
+                .handle_update(Update::Block(BlockUpdate::New {
+                    number: n,
+                    hash: keccak256(n.to_be_bytes()),
+                    timestamp: block_timestamp(n),
+                    logs_bloom: Default::default(),
+                }))
+                .await
+                .unwrap();
+            commands.extend(
+                machine
+                    .handle_update(Update::Logs(EventUpdate {
+                        blocks: (n..=n).into(),
+                        logs: logs_for(n),
+                    }))
+                    .await
+                    .unwrap(),
+            );
+            commands
+        };
+
+        let at_s = apply(&mut machine, S).await;
+        assert!(at_s.contains(&engine_check_effect(id, TO, S)));
+        let mut after = machine
+            .handle_resume(effect::Resume::EngineCheckResult {
+                request_id: id,
+                outcome: CheckOutcome::Approved,
+            })
+            .await
+            .unwrap();
+        after.extend(apply(&mut machine, S + 1).await);
+        after.extend(apply(&mut machine, S + 2).await);
+        if rollback {
+            after.extend(
+                machine
+                    .handle_update(Update::Block(BlockUpdate::Uncle { number: S + 1 }))
+                    .await
+                    .unwrap(),
+            );
+        }
+        let replay_from = if rollback { S + 1 } else { S + 3 };
+        for n in replay_from..=S + 7 {
+            after.extend(apply(&mut machine, n).await);
+        }
+        let (state,) = sqlx::query_as::<_, (String,)>(
+            "SELECT state FROM snapshots ORDER BY block_number DESC LIMIT 1",
+        )
+        .fetch_one(&pool)
+        .await
+        .unwrap();
+        let state: State = serde_json::from_str(&state).unwrap();
+        (after, state.0.get(&id).cloned())
+    }
+
+    #[tokio::test]
+    async fn qa3_rollback_to_the_proposal_block_loses_the_verdict_and_the_reveal() {
+        let is_reveal = |command: &Command<SentinelAction, effect::Effect>| {
+            matches!(command, Command::Action(action) if matches!(action.kind, SentinelActionKind::Reveal { .. }))
+        };
+        let (live, live_state) = qa3_run(false).await;
+        println!("no rollback: commands after the verdict: {live:?}");
+        println!("no rollback: request state in the newest snapshot: {live_state:?}");
+        let (replayed, replayed_state) = qa3_run(true).await;
+        println!("rollback to S: commands after the verdict: {replayed:?}");
+        println!("rollback to S: request state in the newest snapshot: {replayed_state:?}");
+        assert!(live.iter().any(is_reveal));
+        assert!(!replayed.iter().any(is_reveal));
+        assert_eq!(replayed_state, None);
+    }
+
