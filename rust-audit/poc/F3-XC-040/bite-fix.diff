 #[derive(Debug)]
 pub struct ParseError {
     position: Option<(usize, usize)>,
-    inner: toml::de::Error,
+    // LT3 bite fix: a redacted message instead of the raw `toml` error.
+    message: String,
+}
+
+fn lt3_redact(text: &str) -> String {
+    let mut out = String::new();
+    let mut quoted = false;
+    let mut escaped = false;
+    for ch in text.chars() {
+        if quoted {
+            if escaped { escaped = false; continue; }
+            if ch == '\\' { escaped = true; continue; }
+            if ch == '"' { quoted = false; out.push_str("<redacted>\""); }
+            continue;
+        }
+        if ch == '"' { quoted = true; }
+        out.push(ch);
+    }
+    out
 }
 
