+    /// QA3 F3-CORE-002: with `use_client_filtering`, three bloom mismatches
+    /// exhaust the integrity check and the unchecked per-event fallback
+    /// accepts an empty answer for a block whose header bloom holds a watched
+    /// `Transfer` log.
+    #[tokio::test]
+    async fn qa3_client_filtering_accepts_empty_logs_after_three_mismatches() {
+        let asserter = Asserter::new();
+        let mut events = watcher(
+            &asserter,
+            Config {
+                use_client_filtering: true,
+                ..Default::default()
+            },
+        );
+        let transfer = log(
+            (1337, 0),
+            Erc20::Transfer {
+                amount: uint!(1_U256),
+                ..Default::default()
+            },
+        );
+        let header_bloom = bloom::compute_logs_bloom(std::slice::from_ref(&transfer));
+        assert!(bloom::may_contain_log(
+            &header_bloom,
+            &[WATCHED],
+            &[Erc20::Transfer::SIGNATURE_HASH]
+        ));
+        events
+            .on_block_update(BlockUpdate::New {
+                number: 1337,
+                hash: B256::repeat_byte(0x13),
+                timestamp: block_timestamp(1337),
+                logs_bloom: header_bloom,
+            })
+            .unwrap();
+
+        // A node inside its "too soon" window answers every query with `[]`:
+        // three client-filtered attempts, then one query per event (two).
+        for _ in 0..5 {
+            asserter.push_success(&Vec::<Log>::new());
+        }
+        for attempt in 1..=3 {
+            let result = events.next().await;
+            println!("attempt {attempt} (client filtered): {result:?}");
+            assert_matches!(result, Err(Error::IncompleteLogs { .. }));
+        }
+        let result = events.next().await;
+        println!("attempt 4 (one query per event): {result:?}");
+        assert_eq!(
+            result.unwrap(),
+            Some(EventUpdate {
+                blocks: range(1337..=1337),
+                logs: vec![],
+            })
+        );
+        // The block is done: the watcher is idle and never asks again.
+        assert_eq!(events.next().await.unwrap(), None);
+        assert!(asserter.read_q().is_empty());
+    }
+
