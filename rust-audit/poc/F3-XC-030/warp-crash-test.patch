+/// QA3 PoC support: a provider over an in-process transport, so tests can model
+/// time-dependent node behaviour that the FIFO `Asserter` cannot.
+#[cfg(test)]
+impl Provider {
+    pub fn qa3_from_transport<T>(transport: T, chain_id: u64) -> Self
+    where
+        T: alloy::transports::IntoBoxTransport,
+    {
+        let client = ClientBuilder::default().transport(transport, true);
+        Self {
+            root: RootProvider::new(client),
+            chain_id,
+        }
+    }
+}
