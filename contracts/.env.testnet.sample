# Safenet testnet deployment runbook config, consumed both by the podman/forge deployment
# commands and by `just deployment_batch`/`just verify_deployment` (which only need the
# RPC/consensus/oracle settings below, plus the "Safe Transaction Builder Settings" section).

# General Settings
# 1 = SafeSingletonFactory (Default), 2 = Canonical Deterministic Deployment Factory
FACTORY=1

# Consensus Settings
# Validator addresses, comma separated.
PARTICIPANTS=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266,0x70997970C51812dc3A010C7d01b50e0d17dc79C8
GENESIS_SALT=0x5afe000000000000000000000000000000000000000000000000000000000001

# Oracle Settings
SENTINEL_ARBITRATOR=0x9965507D1a55bcC2695C58ba16FB37d819B0A4dc
SENTINEL_GOVERNANCE=0x9965507D1a55bcC2695C58ba16FB37d819B0A4dc
SENTINEL_PROTOCOL_FUNDS_RECEIVER=0x9965507D1a55bcC2695C58ba16FB37d819B0A4dc
SENTINEL_REQUEST_FEE=400000000000000000
SENTINEL_COMMIT_WINDOW=2
SENTINEL_REVEAL_WINDOW=3
SENTINEL_GOVERNANCE_DELAY=0
SENTINEL_BOND_MULTIPLIER=2000
SENTINEL_INITIAL_SLASHING_MULTIPLIER=20
SENTINEL_INITIAL_DAO_FEE_SHARE=10000
SENTINEL_ARBITRATION_TIMEOUT=50400
SENTINEL_CHARTER_ENS=charter.safenet-gov.eth
# Only needed if you already have a fee token deployed; otherwise leave blank and
# `just deployment_batch` deploys a fresh one as part of its batch.
SENTINEL_FEE_TOKEN=

# Safe Transaction Builder Settings (just deployment_batch / just verify_deployment)
# The Safe that will execute the generated batch.
SAFE_ADDRESS=
# Sentinel addresses to register via addSentinel, comma separated.
SENTINEL_ADDRESSES=
# Amount minted to each SENTINEL_ADDRESSES entry when a fresh fee token is deployed (ignored if
# SENTINEL_FEE_TOKEN is already set), in raw token units (18 decimals). Default: 100000 tokens.
SENTINEL_MINT_AMOUNT=100000000000000000000000

# Secrets
# Required by `just deployment_batch`/`just verify_deployment` (read-only: used to see the target
# chain's deployed CREATE2 factory, predict addresses, and check verification status — never to
# sign anything).
RPC_URL=
# Optional. Used by `just verify_deployment` to verify via Etherscan; if unset, it falls back to
# Sourcify (forge's default verifier), which needs no API key.
ETHERSCAN_KEY=
